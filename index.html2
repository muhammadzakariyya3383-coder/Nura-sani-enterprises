    o.status==="Ready" || o.status==="Delivered"
  );

  const box=document.getElementById("deliveryTable");

  if(!list.length){
    box.innerHTML='<div class="empty">No orders ready for delivery.</div>';
    return;
  }

  box.innerHTML=`
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Order</th>
        <th>Customer</th>
        <th>Phone</th>
        <th>Total</th>
        <th>Balance</th>
        <th>Status</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      ${list.map(o=>{

        const c=db.customers.find(x=>x.id===o.customerId);

        return `
        <tr>
          <td>${o.orderNo}</td>
          <td>${escapeHTML(c?.name||"-")}</td>
          <td>${escapeHTML(c?.phone||"-")}</td>
          <td>${money(o.total)}</td>
          <td>${money(orderBalance(o))}</td>
          <td>${statusBadge(o.status)}</td>
          <td>
            ${o.status==="Ready"
              ? `<button class="btn btn-success"
                    onclick="markDelivered('${o.id}')">
                    Mark Delivered
                 </button>`
              : `<span class="badge badge-delivered">Delivered</span>`
            }
          </td>
        </tr>`;
      }).join("")}
    </tbody>
  </table>
  </div>`;
}

function markDelivered(id){

  const order=db.orders.find(o=>o.id===id);

  if(!order)return;

  if(orderBalance(order)>0){

    if(!confirm(
      "This order still has an outstanding balance. Mark as delivered anyway?"
    )) return;

  }

  order.status="Delivered";

  saveDB();
  renderAll();
}

/* PAYMENTS */

function savePayment(){

  const orderId=document.getElementById("paymentOrder").value;
  const amount=Number(document.getElementById("paymentAmount").value)||0;

  if(!orderId || amount<=0){
    alert("Please select an order and enter a valid amount.");
    return;
  }

  const order=db.orders.find(o=>o.id===orderId);

  if(!order)return;

  if(amount>orderBalance(order)){
    alert("Payment exceeds outstanding balance.");
    return;
  }

  db.payments.push({
    id:uid("PAY-"),
    orderId,
    amount,
    method:document.getElementById("paymentMethod").value,
    date:document.getElementById("paymentDate").value || today(),
    reference:document.getElementById("paymentReference").value.trim()
  });

  order.paid=Number(order.paid||0)+amount;

  saveDB();
  closeModal("paymentModal");
  renderAll();

}

function renderPayments(){

  const box=document.getElementById("paymentsTable");

  if(!db.payments.length){
    box.innerHTML='<div class="empty">No payments recorded.</div>';
    return;
  }

  box.innerHTML=`
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Date</th>
        <th>Order</th>
        <th>Customer</th>
        <th>Amount</th>
        <th>Method</th>
        <th>Reference</th>
      </tr>
    </thead>
    <tbody>
      ${db.payments.slice().reverse().map(p=>{

        const o=db.orders.find(x=>x.id===p.orderId);

        return `
        <tr>
          <td>${p.date}</td>
          <td>${o?.orderNo||"-"}</td>
          <td>${escapeHTML(o ? customerName(o.customerId) : "-")}</td>
          <td><strong>${money(p.amount)}</strong></td>
          <td>${escapeHTML(p.method)}</td>
          <td>${escapeHTML(p.reference||"-")}</td>
        </tr>`;
      }).join("")}
    </tbody>
  </table>
  </div>`;
}

