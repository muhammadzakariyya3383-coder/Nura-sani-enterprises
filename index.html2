<!-- ORDER MODAL -->
<div id="orderModal" class="modal">
  <div class="modal-box">

    <div class="modal-header">
      <h2>New Order</h2>
      <button class="close"
              onclick="closeModal('orderModal')">×</button>
    </div>

    <div class="form-grid">

      <div class="form-group">
        <label>Customer *</label>
        <select id="orderCustomer"></select>
      </div>

      <div class="form-group">
        <label>School / Group</label>
        <input id="orderSchool">
      </div>

      <div class="form-group">
        <label>Product *</label>
        <select id="orderProduct">
          <option>Jersey</option>
          <option>T-Shirt</option>
          <option>Polo</option>
          <option>Hoodie</option>
          <option>Custom Print</option>
          <option>Other</option>
        </select>
      </div>

      <div class="form-group">
        <label>Design</label>
        <input id="orderDesign"
               placeholder="Design name / reference">
      </div>

      <div class="form-group">
        <label>Quantity *</label>
        <input id="orderQuantity"
               type="number"
               min="1"
               value="1"
               oninput="calculateOrderTotal()">
      </div>

      <div class="form-group">
        <label>Unit Price *</label>
        <input id="orderUnitPrice"
               type="number"
               min="0"
               value="0"
               oninput="calculateOrderTotal()">
      </div>

      <div class="form-group">
        <label>Total</label>
        <input id="orderTotal"
               type="number"
               readonly>
      </div>

      <div class="form-group">
        <label>Initial Payment</label>
        <input id="orderPayment"
               type="number"
               min="0"
               value="0">
      </div>

      <div class="form-group">
        <label>Due Date</label>
        <input id="orderDueDate" type="date">
      </div>

      <div class="form-group">
        <label>Status</label>
        <select id="orderStatus">
          <option>Pending</option>
          <option>Designing</option>
          <option>Printing</option>
          <option>Ready</option>
          <option>Delivered</option>
        </select>
      </div>

      <div class="form-group form-full">
        <label>Notes</label>
        <textarea id="orderNotes"></textarea>
      </div>

    </div>

    <div class="form-actions">
      <button class="btn btn-light"
              onclick="closeModal('orderModal')">
        Cancel
      </button>

      <button class="btn btn-primary"
              onclick="saveOrder()">
        Create Order
      </button>
    </div>

  </div>
</div>


