<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0f766e">
<title>Nura Sani Enterprises | Business Management System</title>

<style>
:root{
  --primary:#0f766e;
  --primary-dark:#115e59;
  --primary-light:#ccfbf1;
  --accent:#14b8a6;
  --bg:#f4f7f9;
  --card:#ffffff;
  --text:#172033;
  --muted:#64748b;
  --border:#e2e8f0;
  --danger:#dc2626;
  --warning:#d97706;
  --success:#16a34a;
  --shadow:0 8px 25px rgba(15,23,42,.07);
  --radius:14px;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Inter,Arial,Helvetica,sans-serif;
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
}

button,input,select,textarea{
  font:inherit;
}

button{
  cursor:pointer;
}

.hidden{
  display:none!important;
}

/* LOGIN */
.login-screen{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
  background:
    radial-gradient(circle at top right,#14b8a6 0,transparent 28%),
    linear-gradient(135deg,#0f766e,#134e4a);
}

.login-box{
  width:100%;
  max-width:430px;
  background:#fff;
  border-radius:24px;
  padding:35px;
  box-shadow:0 25px 70px rgba(0,0,0,.25);
}

.brand-mark{
  width:72px;
  height:72px;
  border-radius:20px;
  background:var(--primary);
  color:white;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:28px;
  font-weight:800;
  margin:0 auto 18px;
}

.login-box h1{
  text-align:center;
  font-size:24px;
}

.login-box .subtitle{
  text-align:center;
  color:var(--muted);
  margin:8px 0 25px;
  font-size:14px;
}

.login-box label{
  display:block;
  font-size:13px;
  font-weight:700;
  margin:15px 0 7px;
}

.login-box input{
  width:100%;
  padding:13px 14px;
  border:1px solid var(--border);
  border-radius:10px;
  outline:none;
}

.login-box input:focus{
  border-color:var(--primary);
}

.login-btn{
  width:100%;
  border:0;
  background:var(--primary);
  color:#fff;
  padding:14px;
  border-radius:10px;
  margin-top:22px;
  font-weight:700;
}

.login-btn:hover{
  background:var(--primary-dark);
}

.login-error{
  background:#fee2e2;
  color:#991b1b;
  padding:10px;
  border-radius:8px;
  margin-top:12px;
  font-size:13px;
  display:none;
}

/* APP */
.app{
  min-height:100vh;
  display:flex;
}

/* SIDEBAR */
.sidebar{
  width:260px;
  background:#0b3f3b;
  color:#fff;
  position:fixed;
  left:0;
  top:0;
  bottom:0;
  overflow-y:auto;
  z-index:1000;
}

.sidebar-brand{
  padding:22px 18px;
  border-bottom:1px solid rgba(255,255,255,.1);
}

.sidebar-brand h2{
  font-size:18px;
}

.sidebar-brand p{
  font-size:11px;
  opacity:.7;
  margin-top:4px;
}

.nav{
  padding:14px 10px;
}

.nav-section{
  color:#8cc7c2;
  font-size:10px;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:1px;
  padding:15px 12px 7px;
}

.nav button{
  width:100%;
  background:none;
  border:0;
  color:#d9f4f1;
  text-align:left;
  padding:11px 13px;
  border-radius:9px;
  margin:2px 0;
  font-size:13px;
  display:flex;
  align-items:center;
  gap:11px;
}

.nav button:hover,
.nav button.active{
  background:rgba(20,184,166,.22);
  color:#fff;
}

.nav-icon{
  width:20px;
  text-align:center;
}

/* MAIN */
.main{
  margin-left:260px;
  width:calc(100% - 260px);
  min-height:100vh;
}

.topbar{
  height:70px;
  background:#fff;
  border-bottom:1px solid var(--border);
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 25px;
  position:sticky;
  top:0;
  z-index:500;
}

.menu-toggle{
  display:none;
  border:0;
  background:var(--primary-light);
  color:var(--primary-dark);
  padding:9px 11px;
  border-radius:8px;
}

.top-title{
  font-weight:800;
}

.top-right{
  display:flex;
  align-items:center;
  gap:12px;
}

.user-chip{
  display:flex;
  align-items:center;
  gap:8px;
  font-size:13px;
  font-weight:700;
}

.avatar{
  width:34px;
  height:34px;
  border-radius:50%;
  background:var(--primary);
  color:white;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:800;
}

.content{
  padding:25px;
}

.page{
  display:none;
}

.page.active{
  display:block;
}

.page-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px;
  margin-bottom:20px;
}

.page-header h1{
  font-size:23px;
}

.page-header p{
  color:var(--muted);
  font-size:13px;
  margin-top:4px;
}

.btn{
  border:0;
  padding:10px 14px;
  border-radius:9px;
  font-weight:700;
  font-size:13px;
}

.btn-primary{
  background:var(--primary);
  color:#fff;
}

.btn-primary:hover{
  background:var(--primary-dark);
}

.btn-light{
  background:#fff;
  border:1px solid var(--border);
  color:var(--text);
}

.btn-danger{
  background:#fee2e2;
  color:#991b1b;
}

.btn-success{
  background:#dcfce7;
  color:#166534;
}

.btn-warning{
  background:#fef3c7;
  color:#92400e;
}

/* DASHBOARD */
.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:16px;
  margin-bottom:20px;
}

.stat-card{
  background:#fff;
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:19px;
  box-shadow:var(--shadow);
}

.stat-top{
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.stat-label{
  color:var(--muted);
  font-size:12px;
  font-weight:700;
}

.stat-icon{
  width:38px;
  height:38px;
  border-radius:10px;
  background:var(--primary-light);
  display:flex;
  align-items:center;
  justify-content:center;
  color:var(--primary-dark);
}

.stat-value{
  font-size:25px;
  font-weight:800;
  margin-top:12px;
}

.stat-small{
  font-size:11px;
  color:var(--muted);
  margin-top:4px;
}

.dashboard-grid{
  display:grid;
  grid-template-columns:2fr 1fr;
  gap:18px;
}

.card{
  background:#fff;
  border:1px solid var(--border);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  padding:18px;
}

.card-title{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:15px;
}

.card-title h3{
  font-size:15px;
}

.table-wrap{
  width:100%;
  overflow-x:auto;
}

table{
  width:100%;
  border-collapse:collapse;
}

th,td{
  padding:11px 10px;
  border-bottom:1px solid var(--border);
  text-align:left;
  font-size:12px;
  white-space:nowrap;
}

th{
  background:#f8fafc;
  color:#475569;
  font-size:11px;
  text-transform:uppercase;
}

.empty{
  padding:35px 15px;
  text-align:center;
  color:var(--muted);
  font-size:13px;
}

.badge{
  display:inline-flex;
  padding:5px 8px;
  border-radius:20px;
  font-size:10px;
  font-weight:800;
}

.badge-pending{
  background:#fef3c7;
  color:#92400e;
}

.badge-progress{
  background:#dbeafe;
  color:#1d4ed8;
}

.badge-ready{
  background:#dcfce7;
  color:#166534;
}

.badge-delivered{
  background:#ccfbf1;
  color:#115e59;
}

/* FORMS */
.form-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:14px;
}

.form-grid.three{
  grid-template-columns:repeat(3,1fr);
}

.form-group label{
  display:block;
  font-size:12px;
  font-weight:700;
  margin-bottom:6px;
}

.form-group input,
.form-group select,
.form-group textarea{
  width:100%;
  border:1px solid var(--border);
  border-radius:9px;
  padding:11px 12px;
  outline:none;
  background:#fff;
}

.form-group textarea{
  min-height:90px;
  resize:vertical;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus{
  border-color:var(--primary);
}

.form-full{
  grid-column:1/-1;
}

.form-actions{
  display:flex;
  justify-content:flex-end;
  gap:8px;
  margin-top:18px;
}

/* SEARCH */
.toolbar{
  display:flex;
  gap:10px;
  margin-bottom:15px;
  flex-wrap:wrap;
}

.search{
  flex:1;
  min-width:220px;
  padding:11px 13px;
  border:1px solid var(--border);
  border-radius:9px;
  outline:none;
}

/* MODAL */
.modal{
  position:fixed;
  inset:0;
  background:rgba(15,23,42,.6);
  display:none;
  align-items:center;
  justify-content:center;
  padding:20px;
  z-index:2000;
}

.modal.show{
  display:flex;
}

.modal-box{
  background:#fff;
  width:100%;
  max-width:700px;
  max-height:90vh;
  overflow-y:auto;
  border-radius:18px;
  padding:22px;
}

.modal-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:20px;
}

.modal-header h2{
  font-size:18px;
}

.close{
  border:0;
  background:#f1f5f9;
  border-radius:8px;
  width:32px;
  height:32px;
}

/* QUICK */
.quick-actions{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
}

.quick{
  border:1px solid var(--border);
  background:#fff;
  border-radius:10px;
  padding:15px;
  text-align:left;
  font-weight:700;
  color:var(--text);
}

.quick:hover{
  border-color:var(--primary);
  background:var(--primary-light);
}

/* ALERT */
.alert{
  padding:12px 14px;
  border-radius:9px;
  margin-bottom:15px;
  font-size:13px;
}

.alert-info{
  background:#e0f2fe;
  color:#075985;
}

/* PRINT */
@media print{
  .sidebar,
  .topbar,
  .no-print,
  .btn{
    display:none!important;
  }

  .main{
    margin:0;
    width:100%;
  }

  .content{
    padding:0;
  }

  .page{
    display:block!important;
  }
}

/* MOBILE */
@media(max-width:1000px){
  .stats{
    grid-template-columns:repeat(2,1fr);
  }

  .dashboard-grid{
    grid-template-columns:1fr;
  }
}

@media(max-width:760px){
  .sidebar{
    transform:translateX(-100%);
    transition:.25s;
  }

  .sidebar.open{
    transform:translateX(0);
  }

  .main{
    margin-left:0;
    width:100%;
  }

  .menu-toggle{
    display:block;
  }

  .topbar{
    padding:0 14px;
  }

  .top-title{
    display:none;
  }

  .content{
    padding:15px;
  }

  .stats{
    grid-template-columns:1fr 1fr;
    gap:10px;
  }

  .stat-card{
    padding:13px;
  }

  .stat-value{
    font-size:20px;
  }

  .form-grid,
  .form-grid.three{
    grid-template-columns:1fr;
  }

  .form-full{
    grid-column:auto;
  }

  .quick-actions{
    grid-template-columns:1fr 1fr;
  }

  .page-header{
    align-items:flex-start;
  }
}

@media(max-width:450px){
  .stats{
    grid-template-columns:1fr;
  }

  .login-box{
    padding:25px 20px;
  }
}
</style>
</head>

<body>

<!-- LOGIN -->
<div id="loginScreen" class="login-screen">
  <div class="login-box">
    <div class="brand-mark">NS</div>
    <h1>Nura Sani Enterprises</h1>
    <div class="subtitle">
      Jersey & Custom Print Management System
    </div>

    <label>Username</label>
    <input id="loginUsername" type="text" placeholder="Enter username">

    <label>Password</label>
    <input id="loginPassword" type="password" placeholder="Enter password">

    <button class="login-btn" onclick="login()">Sign In</button>

    <div id="loginError" class="login-error">
      Invalid username or password.
    </div>

    <div style="text-align:center;margin-top:18px;font-size:11px;color:#94a3b8">
      Demo administrator: admin / admin123
    </div>
  </div>
</div>

<!-- APPLICATION -->
<div id="app" class="app hidden">

  <!-- SIDEBAR -->
  <aside id="sidebar" class="sidebar">

    <div class="sidebar-brand">
      <h2>NURA SANI</h2>
      <p>ENTERPRISES MANAGEMENT SYSTEM</p>
    </div>

    <nav class="nav">

      <div class="nav-section">Main</div>

      <button class="active" onclick="showPage('dashboard',this)">
        <span class="nav-icon">⌂</span> Dashboard
      </button>

      <button onclick="showPage('customers',this)">
        <span class="nav-icon">👥</span> Customers
      </button>

      <button onclick="showPage('schools',this)">
        <span class="nav-icon">🏫</span> Schools & Classes
      </button>

      <div class="nav-section">Production</div>

      <button onclick="showPage('orders',this)">
        <span class="nav-icon">👕</span> Orders
      </button>

      <button onclick="showPage('names',this)">
        <span class="nav-icon">✍</span> Student Names
      </button>

      <button onclick="showPage('production',this)">
        <span class="nav-icon">🖨</span> Production
      </button>

      <button onclick="showPage('delivery',this)">
        <span class="nav-icon">📦</span> Delivery
      </button>

      <div class="nav-section">Finance</div>

      <button onclick="showPage('payments',this)">
        <span class="nav-icon">₦</span> Payments
      </button>

      <button onclick="showPage('expenses',this)">
        <span class="nav-icon">💸</span> Expenses
      </button>

      <button onclick="showPage('reports',this)">
        <span class="nav-icon">📊</span> Reports
      </button>

      <div class="nav-section">Management</div>

      <button onclick="showPage('staff',this)">
        <span class="nav-icon">👨‍💼</span> Staff
      </button>

      <button onclick="showPage('activity',this)">
        <span class="nav-icon">📋</span> Work Activity
      </button>

      <button onclick="showPage('settings',this)">
        <span class="nav-icon">⚙</span> Settings
      </button>

      <div class="nav-section">System</div>

      <button onclick="backupData()">
        <span class="nav-icon">⬇</span> Backup
      </button>

      <button onclick="document.getElementById('restoreFile').click()">
        <span class="nav-icon">⬆</span> Restore
      </button>

      <input id="restoreFile" type="file" accept=".json"
             style="display:none" onchange="restoreData(event)">

      <button onclick="logout()">
        <span class="nav-icon">↪</span> Logout
      </button>

    </nav>
  </aside>

  <!-- MAIN -->
  <main class="main">

    <header class="topbar">
      <button class="menu-toggle" onclick="toggleSidebar()">☰</button>

      <div class="top-title">
        Business Management System
      </div>

      <div class="top-right">
        <div class="user-chip">
          <div class="avatar">A</div>
          Administrator
        </div>
      </div>
    </header>

    <section class="content">

      <!-- DASHBOARD -->
      <div id="page-dashboard" class="page active">

        <div class="page-header">
          <div>
            <h1>Dashboard</h1>
            <p>Business overview and operational summary.</p>
          </div>
          <button class="btn btn-primary"
                  onclick="openOrderModal()">
            + New Order
          </button>
        </div>

        <div class="stats">

          <div class="stat-card">
            <div class="stat-top">
              <div class="stat-label">TOTAL CUSTOMERS</div>
              <div class="stat-icon">👥</div>
            </div>
            <div id="statCustomers" class="stat-value">0</div>
            <div class="stat-small">Registered customers</div>
          </div>

          <div class="stat-card">
            <div class="stat-top">
              <div class="stat-label">TOTAL ORDERS</div>
              <div class="stat-icon">👕</div>
            </div>
            <div id="statOrders" class="stat-value">0</div>
            <div class="stat-small">All customer orders</div>
          </div>

          <div class="stat-card">
            <div class="stat-top">
              <div class="stat-label">RECEIVED</div>
              <div class="stat-icon">₦</div>
            </div>
            <div id="statReceived" class="stat-value">₦0</div>
            <div class="stat-small">Total payments received</div>
          </div>

          <div class="stat-card">
            <div class="stat-top">
              <div class="stat-label">OUTSTANDING</div>
              <div class="stat-icon">!</div>
            </div>
            <div id="statOutstanding" class="stat-value">₦0</div>
            <div class="stat-small">Customer balances</div>
          </div>

        </div>

        <div class="card" style="margin-bottom:18px">
          <div class="card-title">
            <h3>Quick Actions</h3>
          </div>

          <div class="quick-actions">
            <button class="quick" onclick="openCustomerModal()">
              👥 Add Customer
            </button>

            <button class="quick" onclick="openOrderModal()">
              👕 New Order
            </button>

            <button class="quick" onclick="openPaymentModal()">
              ₦ Record Payment
            </button>

            <button class="quick" onclick="openExpenseModal()">
              💸 Add Expense
            </button>
          </div>
        </div>

        <div class="dashboard-grid">

          <div class="card">
            <div class="card-title">
              <h3>Recent Orders</h3>
              <button class="btn btn-light"
                      onclick="showPage('orders')">
                View All
              </button>
            </div>

            <div id="recentOrders"></div>
          </div>

          <div class="card">
            <div class="card-title">
              <h3>Order Status</h3>
            </div>

            <div id="statusSummary"></div>
          </div>

        </div>

      </div>

      <!-- CUSTOMERS -->
      <div id="page-customers" class="page">

        <div class="page-header">
          <div>
            <h1>Customers</h1>
            <p>Manage customers, schools and contact information.</p>
          </div>

          <button class="btn btn-primary"
                  onclick="openCustomerModal()">
            + Add Customer
          </button>
        </div>

        <div class="card">

          <div class="toolbar">
            <input id="customerSearch"
                   class="search"
                   placeholder="Search customer, phone or school..."
                   oninput="renderCustomers()">
          </div>

          <div id="customersTable"></div>

        </div>
      </div>

      <!-- SCHOOLS -->
      <div id="page-schools" class="page">

        <div class="page-header">
          <div>
            <h1>Schools & Classes</h1>
            <p>Manage schools, classes and graduation groups.</p>
          </div>

          <button class="btn btn-primary"
                  onclick="openSchoolModal()">
            + Add School
          </button>
        </div>

        <div class="card">
          <div id="schoolsTable"></div>
        </div>

      </div>

      <!-- ORDERS -->
      <div id="page-orders" class="page">

        <div class="page-header">
          <div>
            <h1>Orders</h1>
            <p>Track jersey and custom printing orders.</p>
          </div>

          <button class="btn btn-primary"
                  onclick="openOrderModal()">
            + New Order
          </button>
        </div>

        <div class="card">

          <div class="toolbar">
            <input id="orderSearch"
                   class="search"
                   placeholder="Search order, customer or school..."
                   oninput="renderOrders()">

            <select id="orderStatusFilter"
                    class="search"
                    style="max-width:190px"
                    onchange="renderOrders()">
              <option value="">All Statuses</option>
              <option>Pending</option>
              <option>Designing</option>
              <option>Printing</option>
              <option>Ready</option>
              <option>Delivered</option>
            </select>
          </div>

          <div id="ordersTable"></div>

        </div>
      </div>

      <!-- NAMES -->
      <div id="page-names" class="page">

        <div class="page-header">
          <div>
            <h1>Student Names & Jersey Numbers</h1>
            <p>Manage names, sizes and jersey numbers for bulk orders.</p>
          </div>
        </div>

        <div class="card">

          <div class="toolbar">
            <select id="nameOrderFilter"
                    class="search"
                    onchange="renderNames()">
              <option value="">All Orders</option>
            </select>

            <button class="btn btn-primary"
                    onclick="openNameModal()">
              + Add Student
            </button>
          </div>

          <div id="namesTable"></div>

        </div>
      </div>

      <!-- PRODUCTION -->
      <div id="page-production" class="page">

        <div class="page-header">
          <div>
            <h1>Production & Printing</h1>
            <p>Manage the production queue from design to completion.</p>
          </div>
        </div>

        <div class="card">
          <div id="productionTable"></div>
        </div>

      </div>

      <!-- DELIVERY -->
      <div id="page-delivery" class="page">

        <div class="page-header">
          <div>
            <h1>Delivery</h1>
            <p>Track completed orders and customer deliveries.</p>
          </div>
        </div>

        <div class="card">
          <div id="deliveryTable"></div>
        </div>

      </div>

      <!-- PAYMENTS -->
      <div id="page-payments" class="page">

        <div class="page-header">
          <div>
            <h1>Payments</h1>
            <p>Record payments and monitor customer balances.</p>
          </div>

          <button class="btn btn-primary"
                  onclick="openPaymentModal()">
            + Record Payment
          </button>
        </div>

        <div class="card">
          <div id="paymentsTable"></div>
        </div>

      </div>

      <!-- EXPENSES -->
      <div id="page-expenses" class="page">

        <div class="page-header">
          <div>
            <h1>Expenses</h1>
            <p>Record business expenses and operational costs.</p>
          </div>

          <button class="btn btn-primary"
                  onclick="openExpenseModal()">
            + Add Expense
          </button>
        </div>

        <div class="card">
          <div id="expensesTable"></div>
        </div>

      </div>

      <!-- REPORTS -->
      <div id="page-reports" class="page">

        <div class="page-header">
          <div>
            <h1>Reports</h1>
            <p>Business sales, expenses, payments and profit overview.</p>
          </div>

          <button class="btn btn-primary"
                  onclick="window.print()">
            🖨 Print Report
          </button>
        </div>

        <div class="stats">

          <div class="stat-card">
            <div class="stat-label">SALES VALUE</div>
            <div id="reportSales" class="stat-value">₦0</div>
          </div>

          <div class="stat-card">
            <div class="stat-label">PAYMENTS RECEIVED</div>
            <div id="reportPayments" class="stat-value">₦0</div>
          </div>

          <div class="stat-card">
            <div class="stat-label">EXPENSES</div>
            <div id="reportExpenses" class="stat-value">₦0</div>
          </div>

          <div class="stat-card">
            <div class="stat-label">ESTIMATED PROFIT</div>
            <div id="reportProfit" class="stat-value">₦0</div>
          </div>

        </div>

        <div class="card">
          <div class="card-title">
            <h3>Financial Summary</h3>
          </div>
          <div id="reportSummary"></div>
        </div>

      </div>

      <!-- STAFF -->
      <div id="page-staff" class="page">

        <div class="page-header">
          <div>
            <h1>Staff</h1>
            <p>Manage workers and business team members.</p>
          </div>

          <button class="btn btn-primary"
                  onclick="openStaffModal()">
            + Add Staff
          </button>
        </div>

        <div class="card">
          <div id="staffTable"></div>
        </div>

      </div>

      <!-- ACTIVITY -->
      <div id="page-activity" class="page">

        <div class="page-header">
          <div>
            <h1>Work Activity</h1>
            <p>Monitor assigned business tasks and work progress.</p>
          </div>

          <button class="btn btn-primary"
                  onclick="openActivityModal()">
            + Record Activity
          </button>
        </div>

        <div class="alert alert-info">
          Activity monitoring records business work such as assigned tasks,
          check-ins, orders handled and completed jobs.
        </div>

        <div class="card">
          <div id="activityTable"></div>
        </div>

      </div>

      <!-- SETTINGS -->
      <div id="page-settings" class="page">

        <div class="page-header">
          <div>
            <h1>Business Settings</h1>
            <p>Configure the business information displayed in the system.</p>
          </div>
        </div>

        <div class="card">

          <div class="form-grid">

            <div class="form-group">
              <label>Business Name</label>
              <input id="settingBusinessName">
            </div>

            <div class="form-group">
              <label>Phone</label>
              <input id="settingPhone">
            </div>

            <div class="form-group form-full">
              <label>Address</label>
              <textarea id="settingAddress"></textarea>
            </div>

            <div class="form-group">
              <label>Currency</label>
              <select id="settingCurrency">
                <option value="₦">₦ Nigerian Naira</option>
                <option value="$">$ US Dollar</option>
                <option value="£">£ Pound</option>
                <option value="€">€ Euro</option>
              </select>
            </div>

          </div>

          <div class="form-actions">
            <button class="btn btn-primary"
                    onclick="saveSettings()">
              Save Settings
            </button>
          </div>

        </div>

      </div>

    </section>
  </main>
</div>


<!-- CUSTOMER MODAL -->
<div id="customerModal" class="modal">
