      <button class="btn btn-light"
              onclick="closeModal('activityModal')">
        Cancel
      </button>

      <button class="btn btn-primary"
              onclick="saveActivity()">
        Save Activity
      </button>
    </div>

  </div>
</div>


<script>
/* =========================================================
   NURA SANI ENTERPRISES
   BUSINESS MANAGEMENT SYSTEM
   VERSION 1
========================================================= */

const DB_KEY = "NURA_SANI_ENTERPRISES_DB_V1";

let db = {
  customers: [],
  schools: [],
  orders: [],
  students: [],
  payments: [],
  expenses: [],
  staff: [],
  activities: [],
  settings: {
    businessName: "Nura Sani Enterprises",
    phone: "",
    address: "",
    currency: "₦"
  }
};

function loadDB(){
  const saved = localStorage.getItem(DB_KEY);

  if(saved){
    try{
      db = JSON.parse(saved);
    }catch(e){
      console.error(e);
    }
  }
}

function saveDB(){
  localStorage.setItem(DB_KEY, JSON.stringify(db));
}

function uid(prefix){
  return prefix + Date.now() + Math.floor(Math.random()*999);
}

function today(){
  return new Date().toISOString().split("T")[0];
}

function money(value){
  const currency = db.settings.currency || "₦";
  return currency + Number(value || 0).toLocaleString();
}

/* LOGIN */

function login(){

  const username =
    document.getElementById("loginUsername").value.trim();

  const password =
    document.getElementById("loginPassword").value;

  if(username === "admin" && password === "admin123"){

    sessionStorage.setItem("NSE_LOGGED_IN","1");

    document.getElementById("loginScreen")
      .classList.add("hidden");

    document.getElementById("app")
      .classList.remove("hidden");

    initialize();

  }else{

    document.getElementById("loginError")
      .style.display="block";

  }
}

function logout(){

  sessionStorage.removeItem("NSE_LOGGED_IN");

  document.getElementById("app")
    .classList.add("hidden");

  document.getElementById("loginScreen")
    .classList.remove("hidden");

}

/* INITIALIZATION */

function initialize(){

  loadDB();

  document.getElementById("paymentDate").value=today();
  document.getElementById("expenseDate").value=today();

  loadSettings();

  renderAll();
}

function renderAll(){

  renderDashboard();
  renderCustomers();
  renderSchools();
  renderOrders();
  renderNames();
  renderProduction();
  renderDelivery();
  renderPayments();
  renderExpenses();
  renderReports();
  renderStaff();
  renderActivities();

}

/* NAVIGATION */

function showPage(page,button){

  document.querySelectorAll(".page")
    .forEach(p=>p.classList.remove("active"));

  const target=document.getElementById("page-"+page);

  if(target) target.classList.add("active");

  document.querySelectorAll(".nav button")
    .forEach(b=>b.classList.remove("active"));

  if(button) button.classList.add("active");

  document.getElementById("sidebar")
    .classList.remove("open");

  renderAll();
}

function toggleSidebar(){

  document.getElementById("sidebar")
    .classList.toggle("open");

}

/* MODALS */

function openModal(id){
  document.getElementById(id).classList.add("show");
}

function closeModal(id){
  document.getElementById(id).classList.remove("show");
}

function openCustomerModal(){

  document.getElementById("customerName").value="";
  document.getElementById("customerPhone").value="";
  document.getElementById("customerSchool").value="";
  document.getElementById("customerClass").value="";
  document.getElementById("customerAddress").value="";

  openModal("customerModal");
}

function openSchoolModal(){

  document.getElementById("schoolName").value="";
  document.getElementById("schoolClass").value="";
  document.getElementById("schoolContact").value="";
  document.getElementById("schoolPhone").value="";

  openModal("schoolModal");
}

function openOrderModal(){

  populateCustomerSelect();

  document.getElementById("orderSchool").value="";
  document.getElementById("orderDesign").value="";
  document.getElementById("orderQuantity").value=1;
  document.getElementById("orderUnitPrice").value=0;
  document.getElementById("orderTotal").value=0;
  document.getElementById("orderPayment").value=0;
  document.getElementById("orderDueDate").value="";
  document.getElementById("orderNotes").value="";

  openModal("orderModal");
}

function openNameModal(){

  populateOrderSelect("nameOrder");

  document.getElementById("studentName").value="";
  document.getElementById("studentNumber").value="";
  document.getElementById("studentPrintName").value="";

  openModal("nameModal");
}

function openPaymentModal(){

  populateOrderSelect("paymentOrder");

  document.getElementById("paymentAmount").value="";
  document.getElementById("paymentReference").value="";
  document.getElementById("paymentDate").value=today();

  openModal("paymentModal");
}

function openExpenseModal(){

  document.getElementById("expenseDescription").value="";
  document.getElementById("expenseAmount").value="";
  document.getElementById("expenseDate").value=today();

  openModal("expenseModal");
}

function openStaffModal(){

  document.getElementById("staffName").value="";
  document.getElementById("staffPhone").value="";

  openModal("staffModal");
}

function openActivityModal(){

  populateStaffSelect();

  document.getElementById("activityDescription").value="";

  openModal("activityModal");
}

/* CUSTOMER */

function saveCustomer(){

  const name=document.getElementById("customerName").value.trim();
  const phone=document.getElementById("customerPhone").value.trim();

  if(!name || !phone){
    alert("Customer name and phone are required.");
    return;
  }

  db.customers.push({
    id:uid("CUS-"),
    name,
    phone,
    school:document.getElementById("customerSchool").value.trim(),
    className:document.getElementById("customerClass").value.trim(),
    address:document.getElementById("customerAddress").value.trim(),
    createdAt:new Date().toISOString()
  });

  saveDB();

  closeModal("customerModal");

  renderAll();

  alert("Customer saved successfully.");
}

function renderCustomers(){

  const search=(document.getElementById("customerSearch")?.value || "")
    .toLowerCase();

  const list=db.customers.filter(c =>
    !search ||
    c.name.toLowerCase().includes(search) ||
    c.phone.toLowerCase().includes(search) ||
    (c.school||"").toLowerCase().includes(search)
  );

  const box=document.getElementById("customersTable");

  if(!list.length){
    box.innerHTML='<div class="empty">No customers found.</div>';
    return;
  }

  box.innerHTML=`
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Phone</th>
        <th>School</th>
        <th>Class</th>
        <th>Orders</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      ${list.map(c=>{

        const orders=db.orders.filter(o=>o.customerId===c.id).length;

        return `
        <tr>
          <td><strong>${escapeHTML(c.name)}</strong></td>
          <td>${escapeHTML(c.phone)}</td>
          <td>${escapeHTML(c.school||"-")}</td>
          <td>${escapeHTML(c.className||"-")}</td>
          <td>${orders}</td>
          <td>
            <button class="btn btn-danger"
              onclick="deleteCustomer('${c.id}')">
              Delete
            </button>
          </td>
        </tr>`;
      }).join("")}
    </tbody>
  </table>
  </div>`;
}

function deleteCustomer(id){

  if(!confirm("Delete this customer?")) return;

  db.customers=db.customers.filter(c=>c.id!==id);

  saveDB();
  renderAll();
}

/* SCHOOLS */

function saveSchool(){

  const name=document.getElementById("schoolName").value.trim();

  if(!name){
    alert("School name is required.");
    return;
  }

  db.schools.push({
    id:uid("SCH-"),
    name,
    className:document.getElementById("schoolClass").value.trim(),
    contact:document.getElementById("schoolContact").value.trim(),
    phone:document.getElementById("schoolPhone").value.trim()
  });

  saveDB();
  closeModal("schoolModal");
  renderAll();

}

function renderSchools(){

  const box=document.getElementById("schoolsTable");

  if(!db.schools.length){
    box.innerHTML='<div class="empty">No schools or groups registered.</div>';
    return;
  }

  box.innerHTML=`
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>School</th>
        <th>Class / Group</th>
        <th>Contact</th>
        <th>Phone</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      ${db.schools.map(s=>`
        <tr>
          <td><strong>${escapeHTML(s.name)}</strong></td>
          <td>${escapeHTML(s.className||"-")}</td>
          <td>${escapeHTML(s.contact||"-")}</td>
          <td>${escapeHTML(s.phone||"-")}</td>
          <td>
            <button class="btn btn-danger"
              onclick="deleteSchool('${s.id}')">
              Delete
            </button>
          </td>
        </tr>
      `).join("")}
    </tbody>
  </table>
  </div>`;
}

function deleteSchool(id){

  if(!confirm("Delete this school/group?")) return;

  db.schools=db.schools.filter(s=>s.id!==id);

  saveDB();
  renderAll();

}

/* ORDERS */

function populateCustomerSelect(){

  const select=document.getElementById("orderCustomer");

  select.innerHTML=`
    <option value="">Select customer</option>
    ${db.customers.map(c=>`
      <option value="${c.id}">
        ${escapeHTML(c.name)} — ${escapeHTML(c.phone)}
      </option>
    `).join("")}
  `;
}

function calculateOrderTotal(){

  const qty=Number(document.getElementById("orderQuantity").value)||0;
  const price=Number(document.getElementById("orderUnitPrice").value)||0;

  document.getElementById("orderTotal").value=qty*price;
}

function saveOrder(){

  const customerId=document.getElementById("orderCustomer").value;
  const qty=Number(document.getElementById("orderQuantity").value)||0;
  const price=Number(document.getElementById("orderUnitPrice").value)||0;
  const payment=Number(document.getElementById("orderPayment").value)||0;

  if(!customerId){
    alert("Please select a customer.");
    return;
  }

  if(qty<=0){
    alert("Quantity must be greater than zero.");
    return;
  }

  if(price<0 || payment<0){
    alert("Invalid amount.");
    return;
  }

  const total=qty*price;

  if(payment>total){
    alert("Initial payment cannot exceed order total.");
    return;
  }

  db.orders.push({
    id:uid("ORD-"),
    orderNo:"NS-"+new Date().getFullYear()+"-"+String(db.orders.length+1).padStart(4,"0"),
    customerId,
    school:document.getElementById("orderSchool").value.trim(),
    product:document.getElementById("orderProduct").value,
    design:document.getElementById("orderDesign").value.trim(),
    quantity:qty,
    unitPrice:price,
    total,
    paid:payment,
    status:document.getElementById("orderStatus").value,
    dueDate:document.getElementById("orderDueDate").value,
    notes:document.getElementById("orderNotes").value.trim(),
    createdAt:new Date().toISOString()
  });

  saveDB();

  closeModal("orderModal");

  renderAll();

  alert("Order created successfully.");
}

function customerName(id){

  const c=db.customers.find(x=>x.id===id);

  return c ? c.name : "Unknown Customer";
}

function orderBalance(o){
  return Math.max(0,Number(o.total)-Number(o.paid||0));
}

function renderOrders(){

  const search=(document.getElementById("orderSearch")?.value||"")
    .toLowerCase();

  const status=document.getElementById("orderStatusFilter")?.value||"";

  let list=db.orders.filter(o=>{

    const matchSearch=
      !search ||
      o.orderNo.toLowerCase().includes(search) ||
      customerName(o.customerId).toLowerCase().includes(search) ||
      (o.school||"").toLowerCase().includes(search);

    const matchStatus=!status || o.status===status;

    return matchSearch && matchStatus;
  });

  const box=document.getElementById("ordersTable");

  if(!list.length){
    box.innerHTML='<div class="empty">No orders found.</div>';
    return;
  }

  box.innerHTML=`
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Order</th>
        <th>Customer</th>
        <th>Product</th>
        <th>Qty</th>
        <th>Total</th>
        <th>Paid</th>
        <th>Balance</th>
        <th>Status</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      ${list.map(o=>`
      <tr>
        <td><strong>${o.orderNo}</strong></td>
        <td>${escapeHTML(customerName(o.customerId))}</td>
        <td>${escapeHTML(o.product)}</td>
        <td>${o.quantity}</td>
        <td>${money(o.total)}</td>
        <td>${money(o.paid)}</td>
        <td>${money(orderBalance(o))}</td>
        <td>${statusBadge(o.status)}</td>
        <td>
          <button class="btn btn-light"
            onclick="changeOrderStatus('${o.id}')">
            Status
          </button>
          <button class="btn btn-danger"
            onclick="deleteOrder('${o.id}')">
            Delete
          </button>
        </td>
      </tr>
      `).join("")}
    </tbody>
  </table>
  </div>`;
}

function statusBadge(status){

  let cls="badge-pending";

  if(status==="Designing" || status==="Printing")
    cls="badge-progress";

  if(status==="Ready")
    cls="badge-ready";

  if(status==="Delivered")
    cls="badge-delivered";

  return `<span class="badge ${cls}">${escapeHTML(status)}</span>`;
}

function changeOrderStatus(id){

  const order=db.orders.find(o=>o.id===id);

  if(!order)return;

  const statuses=[
    "Pending",
    "Designing",
    "Printing",
    "Ready",
    "Delivered"
  ];

  const current=statuses.indexOf(order.status);

  const next=statuses[(current+1)%statuses.length];

  order.status=next;

  saveDB();
  renderAll();
}

function deleteOrder(id){

  if(!confirm("Delete this order?"))return;

  db.orders=db.orders.filter(o=>o.id!==id);

  saveDB();
  renderAll();
}

