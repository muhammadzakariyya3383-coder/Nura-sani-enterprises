/* DASHBOARD */

function renderDashboard(){

  document.getElementById("statCustomers").textContent=
    db.customers.length;

  document.getElementById("statOrders").textContent=
    db.orders.length;

  const received=db.orders.reduce(
    (sum,o)=>sum+Number(o.paid||0),0
  );

  const outstanding=db.orders.reduce(
    (sum,o)=>sum+orderBalance(o),0
  );

  document.getElementById("statReceived").textContent=
    money(received);

  document.getElementById("statOutstanding").textContent=
    money(outstanding);

  renderRecentOrders();
  renderStatusSummary();
}

function renderRecentOrders(){

  const box=document.getElementById("recentOrders");

  const list=db.orders.slice(-6).reverse();

  if(!list.length){
    box.innerHTML='<div class="empty">No orders yet.</div>';
    return;
  }

  box.innerHTML=`
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Order</th>
        <th>Customer</th>
        <th>Total</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      ${list.map(o=>`
      <tr>
        <td>${o.orderNo}</td>
        <td>${escapeHTML(customerName(o.customerId))}</td>
        <td>${money(o.total)}</td>
        <td>${statusBadge(o.status)}</td>
      </tr>
      `).join("")}
    </tbody>
  </table>
  </div>`;
}

function renderStatusSummary(){

  const box=document.getElementById("statusSummary");

  const statuses=[
    "Pending",
    "Designing",
    "Printing",
    "Ready",
    "Delivered"
  ];

  box.innerHTML=statuses.map(status=>{

    const count=db.orders.filter(o=>o.status===status).length;

    return `
    <div style="
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:10px 0;
      border-bottom:1px solid var(--border)">
      <span>${statusBadge(status)}</span>
      <strong>${count}</strong>
    </div>`;
  }).join("");
}

/* REPORTS */

function renderReports(){

  const sales=db.orders.reduce(
    (sum,o)=>sum+Number(o.total||0),0
  );

  const payments=db.orders.reduce(
    (sum,o)=>sum+Number(o.paid||0),0
  );

  const expenses=db.expenses.reduce(
    (sum,e)=>sum+Number(e.amount||0),0
  );

  const profit=payments-expenses;

  document.getElementById("reportSales").textContent=money(sales);
  document.getElementById("reportPayments").textContent=money(payments);
  document.getElementById("reportExpenses").textContent=money(expenses);
  document.getElementById("reportProfit").textContent=money(profit);

  document.getElementById("reportSummary").innerHTML=`
    <div class="table-wrap">
    <table>
      <tr>
        <th>Total Order Value</th>
        <td>${money(sales)}</td>
      </tr>
      <tr>
        <th>Total Received</th>
        <td>${money(payments)}</td>
      </tr>
      <tr>
        <th>Total Outstanding</th>
        <td>${money(sales-payments)}</td>
      </tr>
      <tr>
        <th>Total Expenses</th>
        <td>${money(expenses)}</td>
      </tr>
      <tr>
        <th>Cash-Based Profit</th>
        <td><strong>${money(profit)}</strong></td>
      </tr>
    </table>
    </div>
  `;
}

/* SETTINGS */

function loadSettings(){

  document.getElementById("settingBusinessName").value=
    db.settings.businessName || "";

  document.getElementById("settingPhone").value=
    db.settings.phone || "";

  document.getElementById("settingAddress").value=
    db.settings.address || "";

  document.getElementById("settingCurrency").value=
    db.settings.currency || "₦";
}

function saveSettings(){

  db.settings.businessName=
    document.getElementById("settingBusinessName").value.trim();

  db.settings.phone=
    document.getElementById("settingPhone").value.trim();

  db.settings.address=
    document.getElementById("settingAddress").value.trim();

  db.settings.currency=
    document.getElementById("settingCurrency").value;

  saveDB();
  renderAll();

  alert("Business settings saved.");
}

/* BACKUP */

function backupData(){

  const data=JSON.stringify(db,null,2);

  const blob=new Blob([data],{
    type:"application/json"
  });

  const url=URL.createObjectURL(blob);

  const a=document.createElement("a");

  a.href=url;

  a.download=
    "nura-sani-enterprises-backup-"+today()+".json";

  a.click();

  URL.revokeObjectURL(url);
}

/* RESTORE */

function restoreData(event){

  const file=event.target.files[0];

  if(!file)return;

  const reader=new FileReader();

  reader.onload=function(e){

    try{

      const restored=JSON.parse(e.target.result);

      if(!restored.customers ||
         !restored.orders ||
         !restored.settings){

        throw new Error("Invalid backup");
      }

      if(!confirm(
        "Restore this backup? Current browser data will be replaced."
      )) return;

      db=restored;

      saveDB();
      renderAll();
      loadSettings();

      alert("Backup restored successfully.");

    }catch(error){

      alert("Invalid backup file.");

    }

  };

  reader.readAsText(file);

  event.target.value="";
}

/* UTILITIES */

function escapeHTML(value){

  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");
}

/* SESSION AUTO LOGIN */

window.addEventListener("DOMContentLoaded",()=>{

  loadDB();

  if(sessionStorage.getItem("NSE_LOGGED_IN")==="1"){

    document.getElementById("loginScreen")
      .classList.add("hidden");

    document.getElementById("app")
      .classList.remove("hidden");

    initialize();
  }

});

/* CLOSE MODAL WHEN CLICKING OUTSIDE */

document.querySelectorAll(".modal").forEach(modal=>{

  modal.addEventListener("click",function(e){

    if(e.target===modal){
      modal.classList.remove("show");
    }

  });

});
</script>

</body>
</html>
