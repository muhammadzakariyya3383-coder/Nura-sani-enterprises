<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="theme-color" content="#087f5b">
<title>Nura Sani Enterprises — V2.0</title>

<style>
:root{
  --primary:#087f5b;
  --primary2:#0b9b70;
  --dark:#10231d;
  --bg:#f4f7f6;
  --card:#fff;
  --text:#17211e;
  --muted:#6b7773;
  --border:#dfe7e4;
  --danger:#d92d20;
  --warning:#f79009;
  --success:#087f5b;
  --info:#2563eb;
  --shadow:0 8px 25px rgba(16,35,29,.08);
  --radius:14px;
}

*{box-sizing:border-box}
body{
  margin:0;
  font-family:Inter,Segoe UI,Arial,sans-serif;
  background:var(--bg);
  color:var(--text);
}

button,input,select,textarea{font:inherit}
button{cursor:pointer}

.hidden{display:none!important}

#loginScreen{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
  background:linear-gradient(135deg,#062d21,#087f5b,#0ca879);
}

.login-box{
  width:100%;
  max-width:430px;
  background:#fff;
  border-radius:24px;
  padding:35px;
  box-shadow:0 25px 70px rgba(0,0,0,.25);
}

.logo{
  width:65px;
  height:65px;
  border-radius:18px;
  background:var(--primary);
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:900;
  font-size:24px;
  margin:auto auto 15px;
}

.login-box h1{
  text-align:center;
  margin:0;
  font-size:25px;
}

.login-box p{
  text-align:center;
  color:var(--muted);
}

.form-group{margin-bottom:15px}
label{
  display:block;
  font-weight:700;
  font-size:13px;
  margin-bottom:7px;
}

input,select,textarea{
  width:100%;
  border:1px solid var(--border);
  background:#fff;
  padding:11px 13px;
  border-radius:9px;
  outline:none;
}

input:focus,select:focus,textarea:focus{
  border-color:var(--primary);
  box-shadow:0 0 0 3px rgba(8,127,91,.1);
}

textarea{min-height:100px;resize:vertical}

.btn{
  border:0;
  border-radius:9px;
  padding:10px 15px;
  font-weight:700;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:7px;
}

.btn-primary{background:var(--primary);color:#fff}
.btn-primary:hover{background:#066b4d}
.btn-secondary{background:#edf2f0;color:var(--dark)}
.btn-danger{background:#fee4e2;color:var(--danger)}
.btn-warning{background:#fff1d6;color:#9a5b00}
.btn-info{background:#e7efff;color:#1854c7}
.btn-success{background:#dff7ed;color:#087f5b}

.btn-block{width:100%}

#app{
  min-height:100vh;
  display:flex;
}

.sidebar{
  width:260px;
  background:#10231d;
  color:#fff;
  position:fixed;
  left:0;
  top:0;
  bottom:0;
  z-index:1000;
  overflow-y:auto;
  transition:.25s;
}

.brand{
  padding:22px 18px;
  border-bottom:1px solid rgba(255,255,255,.08);
}

.brand-title{
  font-weight:900;
  font-size:18px;
}

.brand-sub{
  color:#9fb5ad;
  font-size:11px;
  margin-top:3px;
}

.nav{
  padding:14px 10px;
}

.nav-section{
  font-size:10px;
  text-transform:uppercase;
  color:#77938a;
  padding:14px 10px 7px;
  font-weight:900;
  letter-spacing:.7px;
}

.nav button{
  width:100%;
  border:0;
  background:transparent;
  color:#cbd8d4;
  padding:11px 12px;
  border-radius:9px;
  text-align:left;
  margin-bottom:3px;
  font-weight:600;
}

.nav button:hover,
.nav button.active{
  background:#087f5b;
  color:#fff;
}

.main{
  margin-left:260px;
  width:calc(100% - 260px);
  min-width:0;
}

.topbar{
  height:70px;
  background:#fff;
  border-bottom:1px solid var(--border);
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 25px;
  position:sticky;
  top:0;
  z-index:500;
}

.menu-btn{
  display:none;
  border:0;
  background:#edf2f0;
  padding:9px 12px;
  border-radius:8px;
}

.top-title{
  font-size:20px;
  font-weight:900;
}

.user-box{
  display:flex;
  align-items:center;
  gap:10px;
}

.avatar{
  width:38px;
  height:38px;
  background:var(--primary);
  color:#fff;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:900;
}

.content{
  padding:25px;
}

.page{
  display:none;
}

.page.active{
  display:block;
}

.page-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px;
  margin-bottom:20px;
  flex-wrap:wrap;
}

.page-header h2{
  margin:0;
  font-size:23px;
}

.page-header p{
  margin:4px 0 0;
  color:var(--muted);
  font-size:13px;
}

.actions{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
}

.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:16px;
  margin-bottom:20px;
}

.stat{
  background:#fff;
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:19px;
  box-shadow:var(--shadow);
}

.stat-label{
  color:var(--muted);
  font-size:12px;
  font-weight:700;
}

.stat-value{
  font-size:27px;
  font-weight:900;
  margin-top:8px;
}

.stat-small{
  margin-top:5px;
  color:var(--muted);
  font-size:11px;
}

.grid-2{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:18px;
}

.grid-3{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
}

.card{
  background:#fff;
  border:1px solid var(--border);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  padding:18px;
  margin-bottom:18px;
}

.card h3{
  margin:0 0 15px;
  font-size:16px;
}

.table-wrap{
  width:100%;
  overflow-x:auto;
}

table{
  width:100%;
  border-collapse:collapse;
  min-width:700px;
}

th,td{
  padding:11px 10px;
  border-bottom:1px solid var(--border);
  text-align:left;
  font-size:13px;
}

th{
  background:#f5f8f7;
  font-size:11px;
  text-transform:uppercase;
  color:#53625d;
}

tr:hover td{background:#fbfdfc}

.badge{
  display:inline-flex;
  padding:5px 8px;
  border-radius:20px;
  font-size:10px;
  font-weight:800;
}

.badge-green{background:#dff7ed;color:#087f5b}
.badge-orange{background:#fff1d6;color:#9a5b00}
.badge-red{background:#fee4e2;color:#b42318}
.badge-blue{background:#e7efff;color:#1854c7}
.badge-gray{background:#edf2f0;color:#58655f}

.modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.55);
  display:none;
  align-items:center;
  justify-content:center;
  z-index:3000;
  padding:15px;
}

.modal.show{display:flex}

.modal-box{
  background:#fff;
  width:100%;
  max-width:720px;
  max-height:92vh;
  overflow-y:auto;
  border-radius:18px;
  padding:22px;
}

.modal-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:18px;
}

.modal-head h3{margin:0}

.close{
  border:0;
  background:#edf2f0;
  width:35px;
  height:35px;
  border-radius:50%;
  font-size:20px;
}

.form-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px;
}

.form-grid .full{grid-column:1/-1}

.modal-footer{
  display:flex;
  justify-content:flex-end;
  gap:8px;
  margin-top:20px;
}

.search-row{
  display:flex;
  gap:10px;
  margin-bottom:15px;
  flex-wrap:wrap;
}

.search-row input{
  max-width:350px;
}

.empty{
  padding:35px;
  text-align:center;
  color:var(--muted);
}

.quick-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
}

.quick{
  border:1px solid var(--border);
  background:#fff;
  padding:15px;
  border-radius:12px;
  cursor:pointer;
}

.quick:hover{
  border-color:var(--primary);
  transform:translateY(-2px);
}

.quick-icon{
  font-size:24px;
  margin-bottom:7px;
}

.quick-title{font-weight:800}
.quick-text{font-size:11px;color:var(--muted);margin-top:3px}

.progress{
  height:8px;
  background:#e9efec;
  border-radius:10px;
  overflow:hidden;
}

.progress-bar{
  height:100%;
  background:var(--primary);
}

.order-flow{
  display:flex;
  gap:5px;
  overflow-x:auto;
  padding:5px 0;
}

.flow-step{
  min-width:120px;
  text-align:center;
  padding:10px;
  border-radius:9px;
  background:#edf2f0;
  font-size:11px;
  font-weight:700;
}

.flow-step.done{
  background:#dff7ed;
  color:#087f5b;
}

.alert{
  padding:12px 14px;
  border-radius:10px;
  margin-bottom:15px;
  font-size:13px;
}

.alert-info{background:#e7efff;color:#1854c7}
.alert-warning{background:#fff1d6;color:#9a5b00}
.alert-danger{background:#fee4e2;color:#b42318}

.toast{
  position:fixed;
  right:20px;
  bottom:20px;
  z-index:5000;
  background:#10231d;
  color:#fff;
  padding:13px 17px;
  border-radius:10px;
  box-shadow:var(--shadow);
  display:none;
}

.toast.show{display:block}

@media(max-width:1100px){
  .stats{grid-template-columns:repeat(2,1fr)}
  .quick-grid{grid-template-columns:repeat(2,1fr)}
  .grid-3{grid-template-columns:1fr 1fr}
}

@media(max-width:800px){
  .sidebar{
    transform:translateX(-100%);
  }

  .sidebar.open{
    transform:translateX(0);
  }

  .main{
    margin-left:0;
    width:100%;
  }

  .menu-btn{display:block}
  .topbar{padding:0 14px}
  .content{padding:15px}

  .top-title{font-size:16px}

  .grid-2,
  .grid-3{
    grid-template-columns:1fr;
  }

  .form-grid{
    grid-template-columns:1fr;
  }

  .form-grid .full{
    grid-column:auto;
  }
}

@media(max-width:550px){
  .stats{
    grid-template-columns:1fr 1fr;
    gap:9px;
  }

  .stat{
    padding:13px;
  }

  .stat-value{
    font-size:21px;
  }

  .quick-grid{
    grid-template-columns:1fr 1fr;
  }

  .login-box{
    padding:25px 18px;
  }
}

@media print{
  .sidebar,.topbar,.actions,.no-print{display:none!important}
  .main{margin:0;width:100%}
  .content{padding:0}
  .card{box-shadow:none;border:0}
}
</style>
</head>

<body>

<!-- LOGIN -->
<div id="loginScreen">
  <div class="login-box">
    <div class="logo">NS</div>
    <h1>Nura Sani Enterprises</h1>
    <p>Jersey & Custom Print Management System V2.0</p>

    <form id="loginForm">
      <div class="form-group">
        <label>Username</label>
        <input id="loginUsername" value="admin" required>
      </div>

      <div class="form-group">
        <label>Password</label>
        <input id="loginPassword" type="password" value="admin123" required>
      </div>

      <button class="btn btn-primary btn-block">Sign In</button>
    </form>

    <p style="font-size:11px;margin-top:18px">
      Demo login: admin / admin123
    </p>
  </div>
</div>

<!-- APPLICATION -->
<div id="app" class="hidden">

  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-title">NURA SANI</div>
      <div class="brand-sub">ENTERPRISES • V2.0</div>
    </div>

    <div class="nav">

      <div class="nav-section">Main</div>

      <button onclick="showPage('dashboard',this)" class="active">📊 Dashboard</button>
      <button onclick="showPage('customers',this)">👥 Customers</button>
      <button onclick="showPage('schools',this)">🏫 Schools & Groups</button>
      <button onclick="showPage('orders',this)">👕 Orders</button>
      <button onclick="showPage('students',this)">🎓 Students</button>

      <div class="nav-section">Production</div>

      <button onclick="showPage('designs',this)">🎨 Designs</button>
      <button onclick="showPage('production',this)">🏭 Production</button>
      <button onclick="showPage('delivery',this)">🚚 Delivery</button>

      <div class="nav-section">Finance</div>

      <button onclick="showPage('payments',this)">💰 Payments</button>
      <button onclick="showPage('expenses',this)">💸 Expenses</button>
      <button onclick="showPage('reports',this)">📈 Reports</button>

      <div class="nav-section">Management</div>

      <button onclick="showPage('staff',this)">👷 Staff</button>
      <button onclick="showPage('activity',this)">📝 Work Activity</button>
      <button onclick="showPage('settings',this)">⚙️ Settings</button>

      <div class="nav-section">System</div>

      <button onclick="backupData()">⬇️ Backup Data</button>
      <button onclick="document.getElementById('restoreInput').click()">⬆️ Restore Data</button>
      <button onclick="logout()">🚪 Logout</button>

      <input id="restoreInput" type="file" accept=".json" hidden onchange="restoreData(event)">
    </div>
  </aside>

  <main class="main">

    <header class="topbar">
      <div style="display:flex;align-items:center;gap:12px">
        <button class="menu-btn" onclick="toggleSidebar()">☰</button>
        <div class="top-title" id="pageTitle">Dashboard</div>
      </div>

      <div class="user-box">
        <div>
          <strong>Administrator</strong>
          <div style="font-size:10px;color:var(--muted)">Admin</div>
        </div>
        <div class="avatar">A</div>
      </div>
    </header>

    <section class="content">

      <!-- DASHBOARD -->
      <div class="page active" id="page-dashboard">

        <div class="page-header">
          <div>
            <h2>Business Dashboard</h2>
            <p>Overview of Nura Sani Enterprises</p>
          </div>

          <div class="actions">
            <button class="btn btn-primary" onclick="openOrderModal()">＋ New Order</button>
            <button class="btn btn-secondary" onclick="window.print()">🖨 Print</button>
          </div>
        </div>

        <div class="stats">

          <div class="stat">
            <div class="stat-label">TOTAL ORDERS</div>
            <div class="stat-value" id="dashOrders">0</div>
            <div class="stat-small">All registered orders</div>
          </div>

          <div class="stat">
            <div class="stat-label">REVENUE</div>
            <div class="stat-value" id="dashRevenue">₦0</div>
            <div class="stat-small">Total payments received</div>
          </div>

          <div class="stat">
            <div class="stat-label">OUTSTANDING</div>
            <div class="stat-value" id="dashOutstanding">₦0</div>
            <div class="stat-small">Customer balances</div>
          </div>

          <div class="stat">
            <div class="stat-label">PROFIT</div>
            <div class="stat-value" id="dashProfit">₦0</div>
            <div class="stat-small">Revenue minus expenses</div>
          </div>

        </div>

        <div class="quick-grid">
          <div class="quick" onclick="openOrderModal()">
            <div class="quick-icon">👕</div>
            <div class="quick-title">New Order</div>
            <div class="quick-text">Register a jersey/custom order</div>
          </div>

          <div class="quick" onclick="openCustomerModal()">
            <div class="quick-icon">👥</div>
            <div class="quick-title">Customer</div>
            <div class="quick-text">Register a customer</div>
          </div>

          <div class="quick" onclick="openPaymentModal()">
            <div class="quick-icon">💰</div>
            <div class="quick-title">Payment</div>
            <div class="quick-text">Record customer payment</div>
          </div>

          <div class="quick" onclick="openExpenseModal()">
            <div class="quick-icon">💸</div>
            <div class="quick-title">Expense</div>
            <div class="quick-text">Record business expense</div>
          </div>
        </div>

        <div class="grid-2" style="margin-top:18px">

          <div class="card">
            <h3>Order Status</h3>
            <div id="dashboardStatus"></div>
          </div>

          <div class="card">
            <h3>Recent Orders</h3>
            <div id="recentOrders"></div>
          </div>

        </div>

        <div class="card">
          <h3>Business Workflow</h3>

          <div class="order-flow">
            <div class="flow-step done">1. Customer</div>
            <div class="flow-step done">2. Order</div>
            <div class="flow-step">3. Students</div>
            <div class="flow-step">4. Design</div>
            <div class="flow-step">5. Payment</div>
            <div class="flow-step">6. Production</div>
            <div class="flow-step">7. Quality Check</div>
            <div class="flow-step">8. Delivery</div>
          </div>
        </div>

      </div>

      <!-- CUSTOMERS -->
      <div class="page" id="page-customers">

        <div class="page-header">
          <div>
            <h2>Customers</h2>
            <p>Manage customers and contact information.</p>
          </div>

          <button class="btn btn-primary" onclick="openCustomerModal()">＋ Add Customer</button>
        </div>

        <div class="card">
          <div class="search-row">
            <input id="customerSearch" placeholder="Search customers..." oninput="renderCustomers()">
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Phone</th>
                  <th>Organization</th>
                  <th>Orders</th>
                  <th>Balance</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="customersTable"></tbody>
            </table>
          </div>
        </div>

      </div>

      <!-- SCHOOLS -->
      <div class="page" id="page-schools">

        <div class="page-header">
          <div>
            <h2>Schools & Groups</h2>
            <p>Manage schools, classes, graduating sets and groups.</p>
          </div>

          <button class="btn btn-primary" onclick="openSchoolModal()">＋ Add School/Group</button>
        </div>

        <div class="card">
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>School/Group</th>
                  <th>Class/Set</th>
                  <th>Session</th>
                  <th>Contact</th>
                  <th>Students</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="schoolsTable"></tbody>
            </table>
          </div>
        </div>

      </div>

      <!-- ORDERS -->
      <div class="page" id="page-orders">

        <div class="page-header">
          <div>
            <h2>Orders</h2>
            <p>Track every customer order from registration to delivery.</p>
          </div>

          <button class="btn btn-primary" onclick="openOrderModal()">＋ New Order</button>
        </div>

        <div class="card">

          <div class="search-row">
            <input id="orderSearch" placeholder="Search order, customer or product..." oninput="renderOrders()">

            <select id="orderStatusFilter" onchange="renderOrders()" style="max-width:200px">
              <option value="">All Statuses</option>
              <option>Pending</option>
              <option>Designing</option>
              <option>Printing</option>
              <option>Ready</option>
              <option>Delivered</option>
            </select>
          </div>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Order No.</th>
                  <th>Customer</th>
                  <th>Product</th>
                  <th>Qty</th>
                  <th>Total</th>
                  <th>Paid</th>
                  <th>Balance</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="ordersTable"></tbody>
            </table>
          </div>

        </div>
      </div>

      <!-- STUDENTS -->
      <div class="page" id="page-students">

        <div class="page-header">
          <div>
            <h2>Students / Jersey List</h2>
            <p>Manage names, numbers, sizes and products for bulk orders.</p>
          </div>

          <button class="btn btn-primary" onclick="openStudentModal()">＋ Add Student</button>
        </div>

        <div class="card">

          <div class="search-row">
            <input id="studentSearch" placeholder="Search student..." oninput="renderStudents()">
          </div>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Order</th>
                  <th>Number</th>
                  <th>Size</th>
                  <th>Product</th>
                  <th>Price</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="studentsTable"></tbody>
            </table>
          </div>

        </div>
      </div>

      <!-- DESIGNS -->
      <div class="page" id="page-designs">

        <div class="page-header">
          <div>
            <h2>Design Management</h2>
            <p>Track customer designs and artwork.</p>
          </div>

          <button class="btn btn-primary" onclick="openDesignModal()">＋ Add Design</button>
        </div>

        <div class="card">
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Design</th>
                  <th>Order</th>
                  <th>Designer</th>
                  <th>Status</th>
                  <th>Notes</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="designsTable"></tbody>
            </table>
          </div>
        </div>

      </div>

      <!-- PRODUCTION -->
      <div class="page" id="page-production">

        <div class="page-header">
          <div>
            <h2>Production & Printing</h2>
