/* DASHBOARD */

function renderDashboard(){

  const revenue=db.payments.reduce((a,p)=>a+Number(p.amount||0),0);

  const expenses=db.expenses.reduce((a,e)=>a+Number(e.amount||0),0);

  const outstanding=db.orders.reduce((a,o)=>a+Number(o.balance||0),0);

  const profit=revenue-expenses;

  document.getElementById("dashOrders").textContent=db.orders.length;
  document.getElementById("dashRevenue").textContent=money(revenue);
  document.getElementById("dashOutstanding").textContent=money(outstanding);
  document.getElementById("dashProfit").textContent=money(profit);

  const statuses=["Pending","Designing","Printing","Ready","Delivered"];

  document.getElementById("dashboardStatus").innerHTML=statuses.map(s=>{

    const count=db.orders.filter(o=>o.status===s).length;

    const percent=db.orders.length
      ? Math.round(count/db.orders.length*100)
      : 0;

    return `
      <div style="margin-bottom:13px">
        <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:5px">
          <strong>${s}</strong>
          <span>${count}</span>
        </div>
        <div class="progress">
          <div class="progress-bar" style="width:${percent}%"></div>
        </div>
      </div>
    `;
  }).join("");

  const recent=db.orders.slice().reverse().slice(0,5);

  document.getElementById("recentOrders").innerHTML=
    recent.length
    ? recent.map(o=>`
      <div style="padding:10px 0;border-bottom:1px solid var(--border)">
        <div style="display:flex;justify-content:space-between;gap:10px">
          <strong>${escapeHTML(o.orderNo)}</strong>
          ${statusBadge(o.status)}
        </div>
        <div style="font-size:11px;color:var(--muted);margin-top:4px">
          ${escapeHTML(customerName(o.customerId))} · ${escapeHTML(o.product)}
        </div>
      </div>
    `).join("")
    : `<div class="empty">No orders yet.</div>`;
}

/* REPORTS */

function renderReports(){

  const sales=db.payments.reduce((a,p)=>a+Number(p.amount||0),0);

  const expenses=db.expenses.reduce((a,e)=>a+Number(e.amount||0),0);

  const outstanding=db.orders.reduce((a,o)=>a+Number(o.balance||0),0);

  document.getElementById("reportSales").textContent=money(sales);
  document.getElementById("reportExpenses").textContent=money(expenses);
  document.getElementById("reportProfit").textContent=money(sales-expenses);
  document.getElementById("reportOutstanding").textContent=money(outstanding);

  const statuses=["Pending","Designing","Printing","Ready","Delivered"];

  document.getElementById("reportOrderStats").innerHTML=statuses.map(s=>`
    <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border)">
      <span>${s}</span>
      <strong>${db.orders.filter(o=>o.status===s).length}</strong>
    </div>
  `).join("");

  const products={};

  db.orders.forEach(o=>{
    products[o.product]=(products[o.product]||0)+Number(o.quantity||0);
  });

  document.getElementById("reportProductStats").innerHTML=
    Object.keys(products).length
    ? Object.entries(products).map(([p,q])=>`
      <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border)">
        <span>${escapeHTML(p)}</span>
        <strong>${q}</strong>
      </div>
    `).join("")
    : `<div class="empty">No product data.</div>`;
}

/* SETTINGS */

function renderSettings(){

  document.getElementById("settingBusinessName").value=db.settings.businessName||"";
  document.getElementById("settingPhone").value=db.settings.phone||"";
  document.getElementById("settingEmail").value=db.settings.email||"";
  document.getElementById("settingCurrency").value=db.settings.currency||"₦";
  document.getElementById("settingAddress").value=db.settings.address||"";
}

function saveSettings(){

  db.settings.businessName=document.getElementById("settingBusinessName").value.trim();
  db.settings.phone=document.getElementById("settingPhone").value.trim();
  db.settings.email=document.getElementById("settingEmail").value.trim();
  db.settings.currency=document.getElementById("settingCurrency").value.trim()||"₦";
  db.settings.address=document.getElementById("settingAddress").value.trim();

  saveDB();
  renderAll();

  toast("Settings saved.");
}

/* PRINT ORDER */

function printOrder(id){

  const o=orderById(id);

  if(!o) return;

  const customer=db.customers.find(c=>c.id===o.customerId);

  const students=db.students.filter(s=>s.orderId===o.id);

  const html=`
  <!DOCTYPE html>
  <html>
  <head>
    <title>${o.orderNo}</title>
    <style>
      body{font-family:Arial;padding:30px;color:#111}
      h1{text-align:center}
      .head{text-align:center}
      .info{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:25px 0}
      table{width:100%;border-collapse:collapse}
      th,td{border:1px solid #ccc;padding:8px;text-align:left}
      th{background:#eee}
      .total{text-align:right;margin-top:20px;font-size:18px}
    </style>
  </head>
  <body>

    <div class="head">
      <h1>${escapeHTML(db.settings.businessName)}</h1>
      <div>${escapeHTML(db.settings.address||"")}</div>
      <div>${escapeHTML(db.settings.phone||"")}</div>
      <h2>ORDER SHEET</h2>
    </div>

    <div class="info">
      <div><strong>Order:</strong> ${escapeHTML(o.orderNo)}</div>
      <div><strong>Date:</strong> ${escapeHTML(o.createdAt.slice(0,10))}</div>
      <div><strong>Customer:</strong> ${escapeHTML(customer?.name||"")}</div>
      <div><strong>Phone:</strong> ${escapeHTML(customer?.phone||"")}</div>
      <div><strong>Product:</strong> ${escapeHTML(o.product)}</div>
      <div><strong>Status:</strong> ${escapeHTML(o.status)}</div>
    </div>

    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Student Name</th>
          <th>Number</th>
          <th>Size</th>
          <th>Product</th>
        </tr>
      </thead>

      <tbody>
        ${
          students.map((s,i)=>`
            <tr>
              <td>${i+1}</td>
              <td>${escapeHTML(s.name)}</td>
              <td>${escapeHTML(s.number)}</td>
              <td>${escapeHTML(s.size)}</td>
              <td>${escapeHTML(s.product)}</td>
            </tr>
          `).join("")
        }
      </tbody>
    </table>

    <div class="total">
      <div>Total: ${money(o.total)}</div>
      <div>Paid: ${money(o.paid)}</div>
      <div>Balance: ${money(o.balance)}</div>
    </div>

    <script>window.print()<\/script>
  </body>
  </html>
  `;

  const w=window.open("","_blank");

  if(w){
    w.document.write(html);
    w.document.close();
  }
}

/* BACKUP */

function backupData(){

  const data=JSON.stringify(db,null,2);

  const blob=new Blob([data],{type:"application/json"});

  const url=URL.createObjectURL(blob);

  const a=document.createElement("a");

  a.href=url;
  a.download=
    "nura-sani-enterprises-backup-"+today()+".json";

  a.click();

  URL.revokeObjectURL(url);

  toast("Backup downloaded.");
}

/* RESTORE */

function restoreData(event){

  const file=event.target.files[0];

  if(!file) return;

  const reader=new FileReader();

  reader.onload=function(){

    try{

      const imported=JSON.parse(reader.result);

      const required=[
        "settings",
        "customers",
        "schools",
        "orders",
        "students",
        "designs",
        "payments",
        "expenses",
        "staff",
        "activities",
        "deliveries"
      ];

      const valid=required.every(k=>Object.prototype.hasOwnProperty.call(imported,k));

      if(!valid){
        alert("Invalid Nura Sani backup file.");
        return;
      }

      if(!confirm("Restore this backup? Current browser data will be replaced.")) return;

      db=imported;

      saveDB();
      renderAll();

      toast("Backup restored successfully.");

    }catch(e){
      alert("Could not read backup file.");
    }

  };

  reader.readAsText(file);

  event.target.value="";
}

/* GLOBAL RENDER */

function renderAll(){

  populateSelects();

  renderDashboard();
  renderCustomers();
  renderSchools();
  renderOrders();
  renderStudents();
  renderDesigns();
  renderProduction();
  renderDelivery();
  renderPayments();
  renderExpenses();
  renderReports();
  renderStaff();
  renderActivity();
  renderSettings();
}

