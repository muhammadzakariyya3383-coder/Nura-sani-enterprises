/* ORDER */

document.getElementById("orderForm").addEventListener("submit",function(e){
  e.preventDefault();

  const quantity=Number(document.getElementById("orderQuantity").value);
  const unitPrice=Number(document.getElementById("orderUnitPrice").value);

  const order={
    id:uid("ORD"),
    orderNo:"NS-"+new Date().getFullYear()+"-"+String(db.orders.length+1).padStart(4,"0"),
    customerId:document.getElementById("orderCustomer").value,
    schoolId:document.getElementById("orderSchool").value,
    product:document.getElementById("orderProduct").value,
    quantity,
    unitPrice,
    total:quantity*unitPrice,
    paid:0,
    balance:quantity*unitPrice,
    status:"Pending",
    deliveryDate:document.getElementById("orderDeliveryDate").value,
    description:document.getElementById("orderDescription").value.trim(),
    createdAt:new Date().toISOString()
  };

  db.orders.push(order);

  saveDB();
  closeModal("orderModal");
  renderAll();
  toast("Order created: "+order.orderNo);
});

/* STUDENT */

document.getElementById("studentForm").addEventListener("submit",function(e){
  e.preventDefault();

  const orderId=document.getElementById("studentOrder").value;
  const order=db.orders.find(o=>o.id===orderId);

  db.students.push({
    id:uid("STU"),
    name:document.getElementById("studentName").value.trim(),
    orderId,
    number:document.getElementById("studentNumber").value.trim(),
    size:document.getElementById("studentSize").value,
    product:document.getElementById("studentProduct").value,
    price:Number(document.getElementById("studentPrice").value||0),
    createdAt:new Date().toISOString()
  });

  if(order){
    order.studentCount=(order.studentCount||0)+1;
  }

  saveDB();
  closeModal("studentModal");
  renderAll();
  toast("Student/jersey record saved.");
});

