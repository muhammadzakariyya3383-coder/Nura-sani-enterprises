/* PRODUCTION */

function renderProduction(){

  const html=db.orders.map(o=>{

    return `
      <tr>
        <td><strong>${escapeHTML(o.orderNo)}</strong></td>
        <td>${escapeHTML(o.product)}</td>
        <td>${o.quantity}</td>
        <td>
          <select onchange="changeOrderStatus('${o.id}',this.value)">
            <option ${o.status==="Pending"?"selected":""}>Pending</option>
            <option ${o.status==="Designing"?"selected":""}>Designing</option>
            <option ${o.status==="Printing"?"selected":""}>Printing</option>
            <option ${o.status==="Ready"?"selected":""}>Ready</option>
            <option ${o.status==="Delivered"?"selected":""}>Delivered</option>
          </select>
        </td>
        <td>—</td>
        <td>${o.status==="Ready"||o.status==="Delivered"?statusBadge("Completed"):statusBadge("Pending")}</td>
        <td>${statusBadge(o.status)}</td>
        <td>
          <button class="btn btn-success" onclick="changeOrderStatus('${o.id}','Ready')">Ready</button>
        </td>
      </tr>
    `;
  }).join("");

  document.getElementById("productionTable").innerHTML=
    html || `<tr><td colspan="8"><div class="empty">No production orders.</div></td></tr>`;
}

