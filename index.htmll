/* DELIVERY */

document.getElementById("deliveryForm").addEventListener("submit",function(e){
  e.preventDefault();

  const orderId=document.getElementById("deliveryOrder").value;
  const order=db.orders.find(o=>o.id===orderId);

  if(!order) return;

  db.deliveries.push({
    id:uid("DEL"),
    orderId,
    date:document.getElementById("deliveryDate").value || today(),
    receiver:document.getElementById("deliveryReceiver").value.trim(),
    method:document.getElementById("deliveryMethod").value,
    notes:document.getElementById("deliveryNotes").value.trim(),
    status:"Delivered",
    createdAt:new Date().toISOString()
  });

  order.status="Delivered";

  saveDB();
  closeModal("deliveryModal");
  renderAll();
  toast("Delivery recorded.");
});

/* SELECTS */

function populateSelects(){

  const customer=document.getElementById("orderCustomer");

  customer.innerHTML=
    `<option value="">Select customer</option>`+
    db.customers.map(c=>
      `<option value="${c.id}">${escapeHTML(c.name)} — ${escapeHTML(c.phone)}</option>`
    ).join("");

  const school=document.getElementById("orderSchool");

  school.innerHTML=
    `<option value="">Select school/group</option>`+
    db.schools.map(s=>
      `<option value="${s.id}">${escapeHTML(s.name)} ${s.className?`— ${escapeHTML(s.className)}`:""}</option>`
    ).join("");

  const orderOptions=
    `<option value="">Select order</option>`+
    db.orders.map(o=>
      `<option value="${o.id}">${escapeHTML(o.orderNo)} — ${escapeHTML(customerName(o.customerId))}</option>`
    ).join("");

  document.getElementById("studentOrder").innerHTML=orderOptions;
  document.getElementById("designOrder").innerHTML=orderOptions;
  document.getElementById("paymentOrder").innerHTML=orderOptions;
  document.getElementById("activityOrder").innerHTML=orderOptions;
  document.getElementById("deliveryOrder").innerHTML=orderOptions;

  document.getElementById("activityStaff").innerHTML=
    `<option value="">Select staff</option>`+
    db.staff.map(s=>
      `<option value="${s.id}">${escapeHTML(s.name)} — ${escapeHTML(s.role)}</option>`
    ).join("");
}

/* HELPERS */

function customerName(id){
  return db.customers.find(c=>c.id===id)?.name || "Unknown";
}

function schoolName(id){
  return db.schools.find(s=>s.id===id)?.name || "-";
}

function orderById(id){
  return db.orders.find(o=>o.id===id);
}

function staffName(id){
  return db.staff.find(s=>s.id===id)?.name || "Unknown";
}

function statusBadge(status){

  const map={
    Pending:"badge-orange",
    Designing:"badge-blue",
    Printing:"badge-blue",
    Ready:"badge-green",
    Delivered:"badge-green",
    Draft:"badge-gray",
    Approved:"badge-green",
    Rejected:"badge-red",
    Active:"badge-green",
    Inactive:"badge-gray",
    Completed:"badge-green",
    "In Progress":"badge-blue"
  };

  return `<span class="badge ${map[status]||"badge-gray"}">${escapeHTML(status)}</span>`;
}

/* DELETE */

function deleteItem(type,id){

  if(!confirm("Delete this record? This action cannot be undone.")) return;

  db[type]=db[type].filter(x=>x.id!==id);

  saveDB();
  renderAll();
  toast("Record deleted.");
}

/* ORDER STATUS */

function changeOrderStatus(id,status){

  const order=db.orders.find(o=>o.id===id);

  if(!order) return;

  order.status=status;

  saveDB();
  renderAll();

  toast("Order status updated.");
}

/* RENDER CUSTOMERS */

function renderCustomers(){

  const q=(document.getElementById("customerSearch")?.value||"").toLowerCase();

  const rows=db.customers.filter(c=>
    `${c.name} ${c.phone} ${c.organization}`.toLowerCase().includes(q)
  );

  const html=rows.map(c=>{

    const orders=db.orders.filter(o=>o.customerId===c.id);

    const balance=orders.reduce((a,o)=>a+Number(o.balance||0),0);

    return `
      <tr>
        <td><strong>${escapeHTML(c.name)}</strong></td>
        <td>${escapeHTML(c.phone)}</td>
        <td>${escapeHTML(c.organization||"-")}</td>
        <td>${orders.length}</td>
        <td>${money(balance)}</td>
        <td>
          <button class="btn btn-danger" onclick="deleteItem('customers','${c.id}')">Delete</button>
        </td>
      </tr>
    `;
  }).join("");

  document.getElementById("customersTable").innerHTML=
    html || `<tr><td colspan="6"><div class="empty">No customers found.</div></td></tr>`;
}

/* SCHOOLS */

function renderSchools(){

  const html=db.schools.map(s=>{

    const students=db.students.filter(st=>{
      const order=db.orders.find(o=>o.id===st.orderId);
      return order?.schoolId===s.id;
    }).length;

    return `
      <tr>
        <td><strong>${escapeHTML(s.name)}</strong></td>
        <td>${escapeHTML(s.className||"-")}</td>
        <td>${escapeHTML(s.session||"-")}</td>
        <td>${escapeHTML(s.contact||"-")}</td>
        <td>${students}</td>
        <td>
          <button class="btn btn-danger" onclick="deleteItem('schools','${s.id}')">Delete</button>
        </td>
      </tr>
    `;
  }).join("");

  document.getElementById("schoolsTable").innerHTML=
    html || `<tr><td colspan="6"><div class="empty">No schools/groups registered.</div></td></tr>`;
}

/* ORDERS */

function renderOrders(){

  const q=(document.getElementById("orderSearch")?.value||"").toLowerCase();
  const filter=document.getElementById("orderStatusFilter")?.value||"";

  const rows=db.orders.filter(o=>{

    const text=
      `${o.orderNo} ${customerName(o.customerId)} ${o.product}`.toLowerCase();

    return text.includes(q) && (!filter || o.status===filter);
  });

  const html=rows.map(o=>{

    return `
      <tr>
        <td><strong>${escapeHTML(o.orderNo)}</strong></td>
        <td>${escapeHTML(customerName(o.customerId))}</td>
        <td>${escapeHTML(o.product)}</td>
        <td>${o.quantity}</td>
        <td>${money(o.total)}</td>
        <td>${money(o.paid)}</td>
        <td>${money(o.balance)}</td>
        <td>
          <select onchange="changeOrderStatus('${o.id}',this.value)">
            ${["Pending","Designing","Printing","Ready","Delivered"].map(s=>
              `<option ${o.status===s?"selected":""}>${s}</option>`
            ).join("")}
          </select>
        </td>
        <td>
          <button class="btn btn-info" onclick="printOrder('${o.id}')">Print</button>
          <button class="btn btn-danger" onclick="deleteItem('orders','${o.id}')">Delete</button>
        </td>
      </tr>
    `;
  }).join("");

  document.getElementById("ordersTable").innerHTML=
    html || `<tr><td colspan="9"><div class="empty">No orders found.</div></td></tr>`;
}

