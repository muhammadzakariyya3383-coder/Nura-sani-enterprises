<div class="toast" id="toast"></div>

<script>
/* =========================================================
   NURA SANI ENTERPRISES V2.0
   Browser Prototype Database
========================================================= */

const DB_KEY = "NURA_SANI_ENTERPRISES_DB_V2";

let db = loadDB();

function defaultDB(){
  return {
    settings:{
      businessName:"Nura Sani Enterprises",
      phone:"",
      email:"",
      address:"",
      currency:"₦"
    },
    customers:[],
    schools:[],
    orders:[],
    students:[],
    designs:[],
    payments:[],
    expenses:[],
    staff:[],
    activities:[],
    deliveries:[]
  };
}

function loadDB(){
  try{
    const saved = localStorage.getItem(DB_KEY);
    if(saved) return JSON.parse(saved);
  }catch(e){}
  return defaultDB();
}

function saveDB(){
  localStorage.setItem(DB_KEY,JSON.stringify(db));
}

function uid(prefix="ID"){
  return prefix+"-"+Date.now()+"-"+Math.random().toString(36).slice(2,7).toUpperCase();
}

function today(){
  return new Date().toISOString().slice(0,10);
}

function money(value){
  return (db.settings.currency || "₦") +
    Number(value || 0).toLocaleString("en-NG",{minimumFractionDigits:0});
}

function escapeHTML(value){
  return String(value ?? "")
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");
}

function toast(message){
  const el=document.getElementById("toast");
  el.textContent=message;
  el.classList.add("show");
  setTimeout(()=>el.classList.remove("show"),2500);
}

/* LOGIN */

document.getElementById("loginForm").addEventListener("submit",function(e){
  e.preventDefault();

  const u=document.getElementById("loginUsername").value.trim();
  const p=document.getElementById("loginPassword").value;

  if(u==="admin" && p==="admin123"){
    sessionStorage.setItem("NSE_V2_LOGIN","1");

    document.getElementById("loginScreen").classList.add("hidden");
    document.getElementById("app").classList.remove("hidden");

    renderAll();
  }else{
    alert("Invalid username or password.");
  }
});

function logout(){
  sessionStorage.removeItem("NSE_V2_LOGIN");
  location.reload();
}

if(sessionStorage.getItem("NSE_V2_LOGIN")==="1"){
  document.getElementById("loginScreen").classList.add("hidden");
  document.getElementById("app").classList.remove("hidden");
}

/* NAVIGATION */

const pageTitles={
  dashboard:"Dashboard",
  customers:"Customers",
  schools:"Schools & Groups",
  orders:"Orders",
  students:"Students / Jersey List",
  designs:"Designs",
  production:"Production & Printing",
  delivery:"Delivery",
  payments:"Payments",
  expenses:"Expenses",
  reports:"Reports",
  staff:"Staff Management",
  activity:"Work Activity",
  settings:"Settings"
};

function showPage(page,btn){
  document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));

  const target=document.getElementById("page-"+page);
  if(target) target.classList.add("active");

  document.querySelectorAll(".nav button").forEach(b=>b.classList.remove("active"));

  if(btn) btn.classList.add("active");

  document.getElementById("pageTitle").textContent=pageTitles[page] || page;

  document.getElementById("sidebar").classList.remove("open");

  renderAll();
}

function toggleSidebar(){
  document.getElementById("sidebar").classList.toggle("open");
}

/* MODALS */

function openModal(id){
  document.getElementById(id).classList.add("show");
}

function closeModal(id){
  document.getElementById(id).classList.remove("show");
}

function openCustomerModal(){
  document.getElementById("customerForm").reset();
  openModal("customerModal");
}

function openSchoolModal(){
  document.getElementById("schoolForm").reset();
  openModal("schoolModal");
}

function openOrderModal(){
  populateSelects();
  document.getElementById("orderForm").reset();
  populateSelects();
  openModal("orderModal");
}

function openStudentModal(){
  populateSelects();
  document.getElementById("studentForm").reset();
  populateSelects();
  openModal("studentModal");
}

function openDesignModal(){
  populateSelects();
  document.getElementById("designForm").reset();
  populateSelects();
  openModal("designModal");
}

function openPaymentModal(){
  populateSelects();
  document.getElementById("paymentForm").reset();
  populateSelects();
  openModal("paymentModal");
}

function openExpenseModal(){
  document.getElementById("expenseForm").reset();
  openModal("expenseModal");
}

function openStaffModal(){
  document.getElementById("staffForm").reset();
  openModal("staffModal");
}

function openActivityModal(){
  populateSelects();
  document.getElementById("activityForm").reset();
  populateSelects();
  openModal("activityModal");
}

function openDeliveryModal(){
  populateSelects();
  document.getElementById("deliveryForm").reset();
  document.getElementById("deliveryDate").value=today();
  populateSelects();
  openModal("deliveryModal");
}

/* CUSTOMER */

document.getElementById("customerForm").addEventListener("submit",function(e){
  e.preventDefault();

  db.customers.push({
    id:uid("CUS"),
    name:document.getElementById("customerName").value.trim(),
    phone:document.getElementById("customerPhone").value.trim(),
    email:document.getElementById("customerEmail").value.trim(),
    organization:document.getElementById("customerOrganization").value.trim(),
    address:document.getElementById("customerAddress").value.trim(),
    createdAt:new Date().toISOString()
  });

  saveDB();
  closeModal("customerModal");
  renderAll();
  toast("Customer saved successfully.");
});

