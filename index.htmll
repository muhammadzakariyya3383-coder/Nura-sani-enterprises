/* PAYMENT */

document.getElementById("paymentForm").addEventListener("submit",function(e){
  e.preventDefault();

  const orderId=document.getElementById("paymentOrder").value;
  const amount=Number(document.getElementById("paymentAmount").value||0);

  const order=db.orders.find(o=>o.id===orderId);

  if(!order){
    alert("Please select an order.");
    return;
  }

  if(amount<=0){
    alert("Enter a valid payment amount.");
    return;
  }

  if(amount>order.balance){
    alert("Payment cannot be greater than the outstanding balance.");
    return;
  }

  db.payments.push({
    id:uid("PAY"),
    orderId,
    amount,
    method:document.getElementById("paymentMethod").value,
    reference:document.getElementById("paymentReference").value.trim(),
    note:document.getElementById("paymentNote").value.trim(),
    date:today(),
    createdAt:new Date().toISOString()
  });

  order.paid=(order.paid||0)+amount;
  order.balance=Math.max(0,order.total-order.paid);

  saveDB();
  closeModal("paymentModal");
  renderAll();
  toast("Payment recorded.");
});

